rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidJoySplitId(id) {
      return id.matches('^(JOY|SPL)-[A-Z0-9]{6}$');
    }

    // JoySplit / Splitzy IDs collection for unique reservation
    match /splitzyIds/{splitzyId} {
      allow read: if isAuthenticated();
      // Allow create only if doc doesn't exist yet and caller claims it for their own uid
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid &&
                    isValidJoySplitId(splitzyId);
      // Immutable once claimed to prevent impersonation
      allow update, delete: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read public profile (name, splitzyId, photo) for friend discovery
      allow read: if isAuthenticated();
      // Can only create their own document
      allow create: if isOwner(userId) &&
                    (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      // Can only update their own document; cannot change their uid or reassign another user's splitzyId
      allow update: if isOwner(userId) &&
                    (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
                    (!('splitzyId' in resource.data) || !('splitzyId' in request.resource.data) || request.resource.data.splitzyId == resource.data.splitzyId);
      allow delete: if false;
    }

    // Canonical Friendships Collection
    match /friendships/{friendshipId} {
      // Any signed-in user can read friendship links (uid pairs + status only):
      // "People you may know" needs to read your friends' friendships.
      allow read: if isAuthenticated();
      // Allow creation when accepting request or initializing relationship
      allow create: if isAuthenticated() &&
                    request.auth.uid in request.resource.data.users &&
                    request.resource.data.status in ['ACTIVE', 'REMOVED'];
      // Either friend can update status (e.g. mark REMOVED or ACTIVE)
      allow update: if isAuthenticated() &&
                    request.auth.uid in resource.data.users;
      allow delete: if isAuthenticated() &&
                    request.auth.uid in resource.data.users;
    }

    // Friend Requests Collection
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() &&
                  (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() &&
                    request.resource.data.senderId == request.auth.uid &&
                    request.resource.data.receiverId != request.auth.uid &&
                    request.resource.data.status == 'PENDING';
      // Sender can cancel, receiver can accept or reject
      allow update: if isAuthenticated() &&
                    ((resource.data.receiverId == request.auth.uid &&
                      (request.resource.data.status in ['ACCEPTED', 'REJECTED'])) ||
                     (resource.data.senderId == request.auth.uid &&
                      request.resource.data.status == 'CANCELLED'));
      allow delete: if isAuthenticated() &&
                    (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    // Groups Collection
    match /groups/{groupId} {
      // Members, invited non-friend invitees, and former members (for historical audit trail) can read
      allow read: if isAuthenticated() &&
                  (request.auth.uid in resource.data.members ||
                   (resource.data.formerMembers != null && request.auth.uid in resource.data.formerMembers) ||
                   (resource.data.invitedMembers != null && request.auth.uid in resource.data.invitedMembers));
      // Creator must be in member list upon creation
      allow create: if isAuthenticated() &&
                    request.resource.data.createdBy == request.auth.uid &&
                    request.auth.uid in request.resource.data.members;
      // Existing members or invited users can update (e.g. accept invite, leave group)
      allow update: if isAuthenticated() &&
                    (request.auth.uid in resource.data.members ||
                     (resource.data.invitedMembers != null && request.auth.uid in resource.data.invitedMembers));
      // ONLY creator can delete or archive the group
      allow delete: if isAuthenticated() &&
                    resource.data.createdBy == request.auth.uid;
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      // Authenticated users can read expenses (filtered by client query for user groups and participation)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.amountPaise is int &&
                    request.resource.data.amountPaise > 0 &&
                    request.resource.data.createdBy == request.auth.uid;
      // Authorized participants or group members can report/confirm payments or update shares
      allow update: if isAuthenticated() &&
                    (resource.data.createdBy == request.auth.uid ||
                     resource.data.payerId == request.auth.uid ||
                     resource.data.recipientId == request.auth.uid ||
                     (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids) ||
                     (resource.data.groupId != null &&
                      exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
                      request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members));
      // Payer or creator can delete expense (when no confirmed payments exist)
      allow delete: if isAuthenticated() &&
                    (resource.data.createdBy == request.auth.uid ||
                     resource.data.payerId == request.auth.uid);
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                  resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      // Recipient can mark read
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }
  }
}
